# family.poweredby.top — HostM Passenger
PassengerAppRoot "/home/ua882038/public_html/family.poweredby.top"
PassengerBaseURI "/"
PassengerPython "/home/ua882038/virtualenv/public_html/family.poweredby.top/3.13/bin/python"

# Maya 2026-10-04: deny repo files in the public docroot (review C1).
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Docroot is the app root. Refuse direct downloads of repo files.
  # Flask still reads them from disk. /static/ and /app/static/ stay public.
  # The file-type rule only fires for files that exist on disk.
  RewriteRule ^(?:logs|tmp|docs|backups|instance|scripts|tests|poweredbytop|cgi-bin|unrelated|data|local_testing|uploads)(?:/|$) - [F,L]
  RewriteRule ^app/(?!static/) - [F,L]
  RewriteRule (^|/)\.(?!well-known) - [F,L]
  RewriteCond %{REQUEST_URI} !^/static/ [NC]
  RewriteCond %{REQUEST_URI} !^/app/static/ [NC]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule \.(?:log|jsonl|json|md|txt|bak|zip|sql|db|sqlite3?|env|ini|cfg|toml|ya?ml|sh|py|pyc|patch|tgz|gz|tar|apk)$ - [F,L,NC]
</IfModule>
