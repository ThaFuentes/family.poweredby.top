SECRET_KEY=change-me-to-a-long-random-string
PBT_TOKEN_SECRET=change-me-to-another-64-char-random-string

# Laptop docker MariaDB (see docker-compose.yml). HostM uses cPanel MYSQL_*.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3312
MYSQL_USER=family_user
MYSQL_PASSWORD=FamilyUserPass2026!
MYSQL_DATABASE=family

DEBUG_MODE=true
REQUIRE_HTTPS=false
HSTS_DISABLED=1
SESSION_COOKIE_SECURE=false

HOST=127.0.0.1
PORT=8060
# Optional laptop TLS (Tailscale IP + cert). HostM terminates HTTPS itself.
# TLS_CERT=
# TLS_KEY=

# Fernet key for notes, captions, and photos. Generated on first boot if omitted.
# FAMILY_DATA_KEY=

# Optional
PBT_TRUSTED_IPS=
PBT_SECURITY_LOG=

# Platform owner console at /platform/
# Required on HostM the first time (then the form closes). Laptop DEBUG_MODE can skip it.
# PLATFORM_BOOTSTRAP_TOKEN=

# SpaceXAI (optional). Owner can also paste the key on /platform/ai
# XAI_API_KEY=
